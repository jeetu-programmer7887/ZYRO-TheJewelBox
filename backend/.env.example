# ── Required ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
JWT_SECRET=use-a-long-random-string-at-least-32-chars
# Comma-separated list of shop origins allowed to call the API (no trailing slash)
FRONTEND_URL=https://zyro-jewellery.vercel.app

# ── New in this release ───────────────────────────────────
# Same value as the frontend's VITE_OAUTH_CLIENT_ID; used to verify Google sign-ins
GOOGLE_CLIENT_ID=
# Vercel Cron sends this as a Bearer token to /api/cron/*. Generate a random string.
CRON_SECRET=jioejffklkajdkjf
# Optional: signs short-lived cookies (defaults to JWT_SECRET)
COOKIE_SECRET=

# ── Existing ──────────────────────────────────────────────
PORT=8080
BREVO_API_KEY=
SENDER_NAME=
SENDER_EMAIL=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
GROQ_API_KEY=
GEMINI_KEY=
# Razorpay (test keys start with rzp_test_). The key id is sent to the browser by
# the backend at checkout, so the frontend no longer needs VITE_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks: URL https://<backend>/api/order/razorpay-webhook
# Events: payment.authorized, payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
