{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    { "path": "/api/cron/order-status", "schedule": "30 0 * * *" },
    { "path": "/api/cron/coin-expiry", "schedule": "0 1 * * *" },
    { "path": "/api/cron/pending-payments", "schedule": "0 2 * * *" }
  ]
}
